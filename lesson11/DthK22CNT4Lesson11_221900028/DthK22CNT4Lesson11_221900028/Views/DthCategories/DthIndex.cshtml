            }
            else
            {
                <span style="color:red">Không hoạt đông</span>
            }
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.DthID }) |
            @Html.ActionLink("Details", "Details", new { id = item.DthID }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.DthID })
        </td>
    </tr>
