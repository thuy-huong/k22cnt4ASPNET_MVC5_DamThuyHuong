@model IEnumerable<DthK22CNT4Lesson11_221900028.Models.DthCategory>

@{
    ViewBag.Title = "Danh mục sản phẩm";
    Layout = "~/Views/Shared/_Dth2210900028Layout.cshtml";
}

<h2>Index</h2>

<p>
    @* @Html.ActionLink("Create New", "Create")*@
</p>
<a href="/DthCategories/create" class="btn btn-primary my-3">Thêm mới</a>
